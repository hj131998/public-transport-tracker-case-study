            "url": {
              "raw": "{{mta_base_url}}/Dataservice/mtagtfsfeeds/nyct%2Fgtfs-l",
              "host": ["{{mta_base_url}}"],
              "path": ["Dataservice", "mtagtfsfeeds", "nyct%2Fgtfs-l"]
            }
          },
          "response": []
        },
        {
          "name": "2.6 MTA Subway Feed - Line G",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/x-protobuf" }
            ],
            "url": {
              "raw": "{{mta_base_url}}/Dataservice/mtagtfsfeeds/nyct%2Fgtfs-g",
              "host": ["{{mta_base_url}}"],
              "path": ["Dataservice", "mtagtfsfeeds", "nyct%2Fgtfs-g"]
