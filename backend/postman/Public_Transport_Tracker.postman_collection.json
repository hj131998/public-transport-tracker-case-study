    {
      "name": "3. Internal BFF API (Our Backend)",
      "description": "These are the endpoints our Spring Boot BFF exposes. The frontend calls these. The BFF internally calls MTA + Transit.land, applies the degradation chain, generates alerts, and returns aggregated responses.",
      "item": [
        {
          "name": "3.1 Aggregated Transit Data (Main Endpoint)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Primary endpoint. Returns aggregated response: vehicles + alerts + route plan + HATEOAS links. The BFF calls MTA/Transit.land internally, applies cache/fallback logic, and returns unified JSON.",
            "url": {
              "raw": "{{bff_base_url}}/api/v1/transit?city=NYC&route=M15",
              "host": ["{{bff_base_url}}"],
              "path": ["api", "v1", "transit"],
              "query": [
                { "key": "city", "value": "NYC" },
                { "key": "route", "value": "M15" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "3.2 Vehicle Positions for Route",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Returns just the vehicle positions for a specific route. Useful for map-only views.",
            "url": {
              "raw": "{{bff_base_url}}/api/v1/transit/M15/vehicles?city=NYC",
              "host": ["{{bff_base_url}}"],
              "path": ["api", "v1", "transit", "M15", "vehicles"],
              "query": [
                { "key": "city", "value": "NYC" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "3.3 Alerts for Route",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Returns conditional alerts generated by AlertService based on current vehicle data (delays, disruptions, crowding, weather).",
            "url": {
              "raw": "{{bff_base_url}}/api/v1/transit/M15/alerts?city=NYC",
              "host": ["{{bff_base_url}}"],
              "path": ["api", "v1", "transit", "M15", "alerts"],
              "query": [
                { "key": "city", "value": "NYC" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "3.4 Route Planning",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Returns route plan with primary route + up to 3 alternatives. Factors in current vehicle delays for estimated journey time.",
            "url": {
              "raw": "{{bff_base_url}}/api/v1/routes/plan?city=NYC&from=Times Square&to=Union Square",
              "host": ["{{bff_base_url}}"],
              "path": ["api", "v1", "routes", "plan"],
              "query": [
                { "key": "city", "value": "NYC" },
                { "key": "from", "value": "Times Square" },
                { "key": "to", "value": "Union Square" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "3.5 Route Alternatives",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Returns alternative routes for a given route ID.",
            "url": {
              "raw": "{{bff_base_url}}/api/v1/routes/M15/alternatives?city=NYC",
              "host": ["{{bff_base_url}}"],
              "path": ["api", "v1", "routes", "M15", "alternatives"],
              "query": [
                { "key": "city", "value": "NYC" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "3.6 Health Check (Liveness)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Liveness probe. Returns UP if the service is running.",
            "url": {
              "raw": "{{bff_base_url}}/api/v1/health",
              "host": ["{{bff_base_url}}"],
              "path": ["api", "v1", "health"]
            }
          },
          "response": []
        },
        {
          "name": "3.7 Readiness Check",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Readiness probe. Confirms cache is operational and returns cache size.",
            "url": {
              "raw": "{{bff_base_url}}/api/v1/health/ready",
              "host": ["{{bff_base_url}}"],
              "path": ["api", "v1", "health", "ready"]
            }
          },
          "response": []
        },
        {
          "name": "3.8 Actuator Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Micrometer metrics endpoint — shows JVM, HTTP, cache, circuit breaker metrics.",
            "url": {
              "raw": "{{bff_base_url}}/actuator/metrics",
              "host": ["{{bff_base_url}}"],
              "path": ["actuator", "metrics"]
            }
          },
          "response": []
        },
        {
          "name": "3.9 Prometheus Scrape Endpoint",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Prometheus-format metrics for scraping. Used by Prometheus container in staging/prod.",
            "url": {
              "raw": "{{bff_base_url}}/actuator/prometheus",
              "host": ["{{bff_base_url}}"],
              "path": ["actuator", "prometheus"]
            }
          },
          "response": []
        },
        {
          "name": "3.10 Circuit Breaker Status",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Shows current state of Resilience4j circuit breakers (CLOSED/OPEN/HALF_OPEN) and failure rates.",
            "url": {
              "raw": "{{bff_base_url}}/actuator/circuitbreakers",
              "host": ["{{bff_base_url}}"],
              "path": ["actuator", "circuitbreakers"]
            }
          },
          "response": []
        },
        {
          "name": "3.11 Swagger UI (Open in Browser)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "OpenAPI/Swagger UI. Open this URL in a browser to see interactive API docs.",
            "url": {
              "raw": "{{bff_base_url}}/swagger-ui.html",
              "host": ["{{bff_base_url}}"],
              "path": ["swagger-ui.html"]
            }
          },
          "response": []
        },
        {
          "name": "3.12 Validation Error - Missing City Param",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Tests error handling: missing required 'city' parameter should return HTTP 400 with ProblemDetail JSON.",
            "url": {
              "raw": "{{bff_base_url}}/api/v1/transit?route=M15",
              "host": ["{{bff_base_url}}"],
              "path": ["api", "v1", "transit"],
              "query": [
                { "key": "route", "value": "M15" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "3.13 Transit Data - Subway Route (L train)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Fetches subway data. MTA subway has no GPS — positions will be 0,0 or fallback to Transit.land/mock. Demonstrates graceful degradation.",
            "url": {
              "raw": "{{bff_base_url}}/api/v1/transit?city=NYC&route=L",
              "host": ["{{bff_base_url}}"],
              "path": ["api", "v1", "transit"],
              "query": [
                { "key": "city", "value": "NYC" },
                { "key": "route", "value": "L" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "3.14 Transit Data - Chicago CTA",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Fetches transit data for Chicago. Uses Transit.land as provider — should return real GPS positions.",
            "url": {
              "raw": "{{bff_base_url}}/api/v1/transit?city=CHICAGO&route=22",
              "host": ["{{bff_base_url}}"],
              "path": ["api", "v1", "transit"],
              "query": [
                { "key": "city", "value": "CHICAGO" },
                { "key": "route", "value": "22" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "3.15 Transit Data - Portland TriMet",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Fetches transit data for Portland. Uses Transit.land — real GPS bus/MAX positions.",
            "url": {
              "raw": "{{bff_base_url}}/api/v1/transit?city=PORTLAND&route=72",
              "host": ["{{bff_base_url}}"],
              "path": ["api", "v1", "transit"],
              "query": [
                { "key": "city", "value": "PORTLAND" },
                { "key": "route", "value": "72" }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
