{
  "info": {
    "name": "Public Transport Tracker - External & Internal APIs",
    "_postman_id": "ptt-collection-2024",
    "description": "Postman collection covering:\n1. External Transit APIs (MTA GTFS-RT, Transit.land) - the upstream data sources\n2. Internal BFF API endpoints - what our backend exposes to the frontend\n\nUse this to understand the data flow from external sources through our BFF to the frontend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "transit_land_api_key",
      "value": "BHJjJDbxPohf0MzTGO2iIyWIoWtSGzOn",
      "type": "string"
    },
    {
      "key": "transit_land_base_url",
      "value": "https://transit.land/api/v2/rest",
      "type": "string"
    },
    {
      "key": "mta_base_url",
      "value": "https://api-endpoint.mta.info",
      "type": "string"
    },
    {
      "key": "bff_base_url",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. External APIs - Transit.land",
      "description": "Direct calls to Transit.land REST API v2. These are the endpoints our TransitLandClient calls internally.",
      "item": [
        {
          "name": "1.1 List GTFS-RT Feeds (Discover available feeds)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{transit_land_base_url}}/feeds?spec=gtfs-rt&apikey={{transit_land_api_key}}",
              "host": ["{{transit_land_base_url}}"],
              "path": ["feeds"],
              "query": [
                { "key": "spec", "value": "gtfs-rt" },
                { "key": "apikey", "value": "{{transit_land_api_key}}" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.2 NYC Bus - Vehicle Positions (Real GPS)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Fetches real-time vehicle positions for NYC MTA buses. This is the primary endpoint our TransitLandClient calls. Returns GTFS-RT data as JSON with actual lat/lon GPS coordinates for every active bus.",
            "url": {
              "raw": "{{transit_land_base_url}}/feeds/f-mta~nyc~rt~bustime/download_latest_rt/vehicle_positions.json?apikey={{transit_land_api_key}}",
              "host": ["{{transit_land_base_url}}"],
              "path": ["feeds", "f-mta~nyc~rt~bustime", "download_latest_rt", "vehicle_positions.json"],
              "query": [
                { "key": "apikey", "value": "{{transit_land_api_key}}" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.3 NYC Bus - Trip Updates (Delays/ETAs)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Fetches trip updates (arrival predictions, delays) for NYC MTA buses via Transit.land.",
            "url": {
              "raw": "{{transit_land_base_url}}/feeds/f-mta~nyc~rt~bustime/download_latest_rt/trip_updates.json?apikey={{transit_land_api_key}}",
              "host": ["{{transit_land_base_url}}"],
              "path": ["feeds", "f-mta~nyc~rt~bustime", "download_latest_rt", "trip_updates.json"],
              "query": [
                { "key": "apikey", "value": "{{transit_land_api_key}}" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.4 NYC Bus - Service Alerts",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Fetches active service alerts for NYC MTA buses via Transit.land.",
            "url": {
              "raw": "{{transit_land_base_url}}/feeds/f-mta~nyc~rt~bustime/download_latest_rt/alerts.json?apikey={{transit_land_api_key}}",
              "host": ["{{transit_land_base_url}}"],
              "path": ["feeds", "f-mta~nyc~rt~bustime", "download_latest_rt", "alerts.json"],
              "query": [
                { "key": "apikey", "value": "{{transit_land_api_key}}" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.5 Chicago CTA - Vehicle Positions",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Real-time vehicle positions for Chicago CTA buses/trains with GPS.",
            "url": {
              "raw": "{{transit_land_base_url}}/feeds/f-dp3-cta~rt/download_latest_rt/vehicle_positions.json?apikey={{transit_land_api_key}}",
              "host": ["{{transit_land_base_url}}"],
              "path": ["feeds", "f-dp3-cta~rt", "download_latest_rt", "vehicle_positions.json"],
              "query": [
                { "key": "apikey", "value": "{{transit_land_api_key}}" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.6 Portland TriMet - Vehicle Positions",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Real-time vehicle positions for Portland TriMet buses and MAX light rail.",
            "url": {
              "raw": "{{transit_land_base_url}}/feeds/f-c20-trimet~rt/download_latest_rt/vehicle_positions.json?apikey={{transit_land_api_key}}",
              "host": ["{{transit_land_base_url}}"],
              "path": ["feeds", "f-c20-trimet~rt", "download_latest_rt", "vehicle_positions.json"],
              "query": [
                { "key": "apikey", "value": "{{transit_land_api_key}}" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.7 SF MUNI - Vehicle Positions",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Real-time vehicle positions for San Francisco MUNI buses and streetcars.",
            "url": {
              "raw": "{{transit_land_base_url}}/feeds/f-9q8y-sfmta~rt/download_latest_rt/vehicle_positions.json?apikey={{transit_land_api_key}}",
              "host": ["{{transit_land_base_url}}"],
              "path": ["feeds", "f-9q8y-sfmta~rt", "download_latest_rt", "vehicle_positions.json"],
              "query": [
                { "key": "apikey", "value": "{{transit_land_api_key}}" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.8 Transit.land - Get Feed Details (inspect a feed)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Get metadata about a specific GTFS-RT feed registered in Transit.land. Useful to see what RT types are available (vehicle_positions, trip_updates, alerts).",
            "url": {
              "raw": "{{transit_land_base_url}}/feeds/f-mta~nyc~rt~bustime?apikey={{transit_land_api_key}}",
              "host": ["{{transit_land_base_url}}"],
              "path": ["feeds", "f-mta~nyc~rt~bustime"],
              "query": [
                { "key": "apikey", "value": "{{transit_land_api_key}}" }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. External APIs - MTA GTFS-RT (Subway)",
      "description": "Direct calls to MTA's free GTFS-RT protobuf endpoint. These are the endpoints our MtaApiClient calls. NOTE: Response is binary protobuf — Postman will show raw bytes. Use the Transit.land JSON proxy above for readable output.",
      "item": [
        {
          "name": "2.1 MTA Subway Feed - Lines 1,2,3,4,5,6,7,S",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/x-protobuf" }
            ],
            "description": "GTFS-RT protobuf feed for NYC subway lines 1-7 and S. Response is binary protobuf (not human-readable in Postman). Contains TripUpdate entities with delay info but vehicle positions have lat=0, lon=0.",
            "url": {
              "raw": "{{mta_base_url}}/Dataservice/mtagtfsfeeds/nyct%2Fgtfs",
              "host": ["{{mta_base_url}}"],
              "path": ["Dataservice", "mtagtfsfeeds", "nyct%2Fgtfs"]
            }
          },
          "response": []
        },
        {
          "name": "2.2 MTA Subway Feed - Lines A,C,E",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/x-protobuf" }
            ],
            "description": "GTFS-RT protobuf feed for NYC subway lines A, C, E.",
            "url": {
              "raw": "{{mta_base_url}}/Dataservice/mtagtfsfeeds/nyct%2Fgtfs-ace",
              "host": ["{{mta_base_url}}"],
              "path": ["Dataservice", "mtagtfsfeeds", "nyct%2Fgtfs-ace"]
            }
          },
          "response": []
