              "host": ["{{mta_base_url}}"],
              "path": ["Dataservice", "mtagtfsfeeds", "nyct%2Fgtfs-bdfm"]
            }
          },
          "response": []
        },
        {
          "name": "2.4 MTA Subway Feed - Lines N,Q,R,W",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/x-protobuf" }
            ],
            "url": {
              "raw": "{{mta_base_url}}/Dataservice/mtagtfsfeeds/nyct%2Fgtfs-nqrw",
              "host": ["{{mta_base_url}}"],
              "path": ["Dataservice", "mtagtfsfeeds", "nyct%2Fgtfs-nqrw"]
            }
          },
          "response": []
        },
        {
          "name": "2.5 MTA Subway Feed - Line L",
          "request": {
            "method": "GET",
